<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
<key>Label</key>
<string>com.example.trading-watcher</string>
<key>ProgramArguments</key>
<array>
<string>/opt/swing-trading-bot/scripts/run_watcher_mac.sh</string>
</array>
<key>StartInterval</key>
<integer>60</integer>
<key>RunAtLoad</key>
<true/>
<key>StandardOutPath</key>
<string>/opt/swing-trading-bot/logs/watcher-launchd.out.log</string>
<key>StandardErrorPath</key>
<string>/opt/swing-trading-bot/logs/watcher-launchd.err.log</string>
<key>LimitLoadToSessionType</key>
<string>Aqua</string>
</dict>
</plist>
